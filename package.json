{
  "name": "wistally-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "verify": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test",
    "db:generate": "pnpm --filter @wistally/db generate",
    "db:migrate": "pnpm --filter @wistally/db migrate",
    "db:seed": "pnpm --filter @wistally/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "dependency-cruiser": "^18.9.0",
    "lefthook": "^1.10.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
