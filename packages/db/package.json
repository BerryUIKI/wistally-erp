{
  "name": "@wistally/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run integration",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "seed-demo": "tsx src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@wistally/domain": "workspace:*",
    "@wistally/kernel": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wistally/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
